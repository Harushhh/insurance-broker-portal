# Copy to .env for local development. Real values never go in git.
# Required in production (DEBUG=False): SECRET_KEY, ALLOWED_HOSTS, PARTNER_SSO_TICKET_SECRET.

DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated; defaults to the current Railway hostname when unset.
CSRF_TRUSTED_ORIGINS=

# Signs the ticket used by the partner-portal SSO handoff (insurance/sso.py).
PARTNER_SSO_TICKET_SECRET=

# Database: DATABASE_URL wins if set; else DB_NAME selects Postgres; else SQLite (db.sqlite3).
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Celery broker + result backend (background MIS mapping, OCR, overlap scans, grid uploads).
REDIS_URL=

# Media storage: Cloudflare R2 is used only when all three of these are set; otherwise local disk.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
# Optional separate bucket for the Grid Management archive.
GRID_ARCHIVE_BUCKET_NAME=

# Outgoing mail (password reset, background notifications).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Gemini API key for AI OCR extraction.
GEMINI_API_KEY=
